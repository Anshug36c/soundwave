<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the Node process alive while a track is playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13+ requires an explicit grant to show the media notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoundWave"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is required: the WebView talks to the embedded
             Node server over http://127.0.0.1. It is loopback only, never the
             network, so this does not expose anything. -->

        <!-- extractNativeLibs must be true. The Node runtime is packaged as
             lib/arm64-v8a/libnode.so so that the installer unpacks it into
             nativeLibraryDir, mode 0755 and labelled apk_data_file. That
             directory is executable from an app's SELinux domain; the app's own
             filesDir is not, so a binary written there and exec'd fails with
             EACCES (errno 13) on Android 10+. With this flag false the library
             would stay compressed inside the APK and never be extracted. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
