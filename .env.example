# Spotify (optional — enhances metadata & recommendations)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LastFM (optional — similar artists, bios)
LASTFM_API_KEY=

# AudioDB (optional — hi-res artist images)
AUDIODB_API_KEY=

# JioSaavn API (works out of the box, self-hostable)
JIOSAAVN_API_URL=https://saavn.dev/api

# Deezer — no key needed
# Lyrics.ovh — no key needed
# MusicBrainz — no key needed

# Server
PORT=5000
NODE_ENV=development
# CORS allowlist — only needed when the front end is hosted on a DIFFERENT origin
# than this server (e.g. static client on Vercel). Comma-separated, no trailing
# slash. Unset = allow any origin (public read-only endpoints, never credentials).
# Leave unset for the normal single-process deploy, where everything is same-origin.
FRONTEND_URL=http://localhost:5173

# Client (create client/.env from these if needed)
# VITE_API_URL=http://localhost:5000/api
